<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>kura-camel-distrib</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>kura-camel-deb</artifactId>
    <packaging>pom</packaging>
    <description>kura-camel Debian package</description>

    <properties>
        <package.name>kura-camel</package.name>
        <summary>Eclipse Kura Add-on for Apache Camel</summary>
        <long.description>Apache Camel integration for the Eclipse Kura Framework: the Camel core and API bundle, the Camel cloud service factory, the XML router component, the Camel wire components and the Camel runtime libraries.</long.description>
    </properties>

    <dependencies>
        <!-- the add-on bundles -->
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.camel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.camel.cloud.factory</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.camel.xml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.kura</groupId>
            <artifactId>org.eclipse.kura.wire.camel</artifactId>
        </dependency>

        <!-- the Camel runtime -->
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-management-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-util</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-util-json</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-support</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-base</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-base-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-management</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-core-model</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-core-reifier</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-core-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-core-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-core-languages</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-core-osgi</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-xml-io</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-xml-io-util</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-xml-jaxp</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-bean</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-direct</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-log</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-seda</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-vm</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-stream</artifactId>
        </dependency>
        <dependency>
            <groupId>${org.apache.camel.groupId}</groupId>
            <artifactId>camel-timer</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                gen_config_ini.sh derives the OSGi start level from the directory name:
                plugins/<n>  => bundle@<n>
                plugins/<n>s => bundle@<n>:start
            -->
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!--
                        Level 5, auto-started. Only camel-core-osgi carries a Bundle-Activator, but
                        every Camel bundle still has to reach ACTIVE: that activator installs a
                        BundleTracker over Bundle.ACTIVE which is what registers each bundle's
                        META-INF/services/org/apache/camel/component, /language and /TypeConverter
                        entries as OSGi services. A Camel bundle left merely installed contributes
                        nothing and fails silently.
                    -->
                    <execution>
                        <id>copy-deps-5s</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <excludeTypes>pom</excludeTypes>
                            <excludeClassifiers>sources</excludeClassifiers>
                            <excludeTransitive>true</excludeTransitive>
                            <outputDirectory>${project.build.directory}/plugins/5s</outputDirectory>
                            <includeArtifactIds>
                                camel-api,
                                camel-management-api,
                                camel-util,
                                camel-util-json,
                                camel-support,
                                camel-base,
                                camel-base-engine,
                                camel-management,
                                camel-core-model,
                                camel-core-reifier,
                                camel-core-processor,
                                camel-core-engine,
                                camel-core-languages,
                                camel-core-osgi,
                                camel-xml-io,
                                camel-xml-io-util,
                                camel-xml-jaxp,
                                camel-bean,
                                camel-direct,
                                camel-log,
                                camel-seda,
                                camel-vm,
                                camel-stream,
                                camel-timer
                            </includeArtifactIds>
                        </configuration>
                    </execution>
                    <!-- Level 6, auto-started: the add-on's own DS components -->
                    <execution>
                        <id>copy-deps-6s</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <excludeTypes>pom</excludeTypes>
                            <excludeClassifiers>sources</excludeClassifiers>
                            <excludeTransitive>true</excludeTransitive>
                            <outputDirectory>${project.build.directory}/plugins/6s</outputDirectory>
                            <includeArtifactIds>
                                org.eclipse.kura.camel,
                                org.eclipse.kura.camel.cloud.factory,
                                org.eclipse.kura.camel.xml,
                                org.eclipse.kura.wire.camel
                            </includeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <executions>
                    <execution>
                        <id>generate-deb</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <dataSet>
                                <data>
                                    <src>${project.build.directory}/plugins/5s</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/5s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.build.directory}/plugins/6s</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>${addon.installation.dir}/6s</prefix>
                                        <user>kurad</user>
                                        <group>kurad</group>
                                        <filemode>600</filemode>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
