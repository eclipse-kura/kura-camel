Bundle-Name: org.eclipse.kura.camel
Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy

# Historical per-package API versions, carried over from the pre-migration MANIFEST.
# They must NOT be flattened to the bundle version: consumers resolve against these ranges.
# The uses: directives are computed by bnd from the bytecode.
# org.eclipse.kura.camel.internal.* is deliberately not exported.
Export-Package: \
    org.eclipse.kura.camel;version="1.1.0",\
    org.eclipse.kura.camel.bean;version="1.1.0",\
    org.eclipse.kura.camel.camelcloud;version="1.1.0",\
    org.eclipse.kura.camel.cloud;version="1.1.0",\
    org.eclipse.kura.camel.component;version="1.1.0",\
    org.eclipse.kura.camel.router;version="1.1.0",\
    org.eclipse.kura.camel.runner;version="1.1.0",\
    org.eclipse.kura.camel.type;version="1.1.0",\
    org.eclipse.kura.camel.utils;version="1.1.0"

# Only the ranges that cannot be derived from the runtime libraries are pinned here:
# the org.eclipse.kura.* API ranges, and commons-io which must stay optional
# (XmlRoutesProvider uses ReaderInputStream but the bundle works without it).
# Everything else, including org.apache.camel.*, is computed by bnd.
Import-Package: \
    org.apache.commons.io.input;version="[2.4,3.0)";resolution:=optional,\
    org.eclipse.kura;version="[1.3,2.0)",\
    org.eclipse.kura.cloud;version="[1.1,1.2)",\
    org.eclipse.kura.configuration;version="[1.1,2.0)",\
    org.eclipse.kura.message;version="[1.0,2.0)",\
    org.eclipse.kura.type;version="[1.1,2.0)",\
    org.eclipse.kura.util.base;version="[1.0,2.0)",\
    org.eclipse.kura.wire;version="[2.0,3.0)",\
    *

-includeresource: \
    about.html,\
    about_files=about_files/
