Bundle-Name: org.eclipse.kura.wire.camel
Bundle-SymbolicName: ${project.artifactId};singleton:=true
Bundle-Vendor: Eclipse Kura
Bundle-ActivationPolicy: lazy

-dsannotations-options: inherit

Import-Package: \
    org.eclipse.kura.configuration;version="[1.2,2.0)",\
    org.eclipse.kura.type;version="[1.1,2.0)",\
    org.eclipse.kura.util.base;version="[1.0,2.0)",\
    org.eclipse.kura.util.osgi;version="[1.0,2.0)",\
    org.eclipse.kura.wire;version="[2.0,3.0)",\
    org.eclipse.kura.camel.component;version="[2.0,3.0)",\
    *

-includeresource: \
    about.html,\
    about_files=about_files/
